[gd_scene format=3]

[node name="Boot" type="CenterContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Lines" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Lines"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "GAME_TITLE"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Lines"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "GAME_SUBTITLE"
horizontal_alignment = 1

[node name="Note" type="Label" parent="Lines"]
layout_mode = 2
text = "BOOT_NOTE"
horizontal_alignment = 1
